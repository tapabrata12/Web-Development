<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link rel="stylesheet" href="/stylesheets/style.css"> -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Note taking app</title>
</head>

<body>
    <main class="w-full min-h-screen bg-zinc-900">

        <div class="form px-10 py-10 text-white">
            <form action="/create" method="POST">
                <input class="block rounded-sm px-2 py-5 w-full outline-none bg-zinc-800" type="text"
                    placeholder="Your task name" name="title">
                <textarea class="block rounded-sm w-full  outline-none px-2 py-4 mt-2 resize-none bg-zinc-800"
                    placeholder="Write the details about your task" name="details"></textarea>
                <input class="px-5 py-2 mt-3 rounded-md bg-blue-800 cursor-pointer" type="submit" value="Add Task">
            </form>
        </div>

        <div class="tasks p-10 flex flex-wrap gap-20">

         <% if(files.length >0){ %>

            <% files.forEach((value)=>{ %>

                <div class="task w-72 px-4 py-3 rounded-md bg-zinc-800">
                <h1 class="text-white text-3xl tracking-tight font-semibold">Wake up</h1>
                <a class="text-blue-500" href="">Read more</a>
                </div>

          <% }) %>
            
           <% } else { %>

             <p class="text-gray-700 bg-zinc-900">No task sheduled</p>

          <% } %>
           
        </div>


    </main>
</body>

</html>